# Copy to .env and adjust. .env is git-ignored.

# Image name (use ghcr.io/antonvynohradov/roboto-origin-runtime:humble after the CI build)
IMAGE=roboto-origin-runtime:humble

# Upstream control code baked into the image
DEPLOY_REPO=https://github.com/Roboparty/roboparty_deploy.git
DEPLOY_REF=main

# Must be identical on the robot and the debug station
ROS_DOMAIN_ID=42

# 1 = record raw CAN frames (candump) for every run on the robot
CAN_LOG=1

# Used by tools/debug/*.sh on the laptop
ROBOT_HOST=raspberrypi.local
ROBOT_USER=pi
